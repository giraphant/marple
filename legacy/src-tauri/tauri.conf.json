{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qua-reader",
  "version": "0.9.0",
  "identifier": "app.qua.reader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/reader/",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "TAURI=1 npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "qua reader", "width": 1280, "height": 860 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": "app"
  }
}
