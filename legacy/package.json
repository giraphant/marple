{
  "name": "marple",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Card-style reader over the qua vault (book / paper / author / topic) with editable properties",
  "scripts": {
    "build:index": "cargo run --release --manifest-path rust/Cargo.toml -p reader-index",
    "build:index:dev": "cargo run --manifest-path rust/Cargo.toml -p reader-index",
    "build:embeddings": "cargo run --release --manifest-path rust/Cargo.toml -p reader-index -- embeddings",
    "api": "cargo run --release --manifest-path rust/Cargo.toml -p reader-api",
    "api:dev": "cargo run --manifest-path rust/Cargo.toml -p reader-api",
    "dev:vite": "vite",
    "dev": "cargo run --release --manifest-path rust/Cargo.toml -p reader-index && concurrently -k -n vite,api -c cyan,magenta \"vite\" \"cargo run --release --manifest-path rust/Cargo.toml -p reader-api\"",
    "build": "cargo run --release --manifest-path rust/Cargo.toml -p reader-index && vite build",
    "serve": "cargo run --release --manifest-path rust/Cargo.toml -p reader-api",
    "test:sql-index": "node scripts/test-sql-index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.11.0",
    "codemirror": "^6.0.2",
    "htm": "^3.1.1",
    "marked": "^12.0.2",
    "preact": "^10.22.0",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@preact/preset-vite": "^2.10.5",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^20.12.7",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.0.13",
    "vitest": "^4.1.7"
  }
}
