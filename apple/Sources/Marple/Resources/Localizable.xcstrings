      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Command Template"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "命令模板"
          }
        }
      }
    },
    "命令经 zsh 执行。可用变量：`$MARPLE_PROMPT_FILE`、`$MARPLE_CONTEXT_FILE`、`$MARPLE_VAULT_ROOT`、`$MARPLE_TITLE`、`$MARPLE_AGENT`、`$MARPLE_WORKSPACE`、`$MARPLE_RUN_SCRIPT`。`$MARPLE_RUN_SCRIPT` 是生成好的启动脚本：cd 到 vault 后把提示词交给代理。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commands run through zsh. Available variables: `$MARPLE_PROMPT_FILE`, `$MARPLE_CONTEXT_FILE`, `$MARPLE_VAULT_ROOT`, `$MARPLE_TITLE`, `$MARPLE_AGENT`, `$MARPLE_WORKSPACE`, and `$MARPLE_RUN_SCRIPT`. `$MARPLE_RUN_SCRIPT` is the generated launch script: it changes to the vault and sends the prompt to the agent."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "命令经 zsh 执行。可用变量：`$MARPLE_PROMPT_FILE`、`$MARPLE_CONTEXT_FILE`、`$MARPLE_VAULT_ROOT`、`$MARPLE_TITLE`、`$MARPLE_AGENT`、`$MARPLE_WORKSPACE`、`$MARPLE_RUN_SCRIPT`。`$MARPLE_RUN_SCRIPT` 是生成好的启动脚本：cd 到 vault 后把提示词交给代理。"
          }
        }
      }
    },
